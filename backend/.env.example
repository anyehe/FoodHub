APP_NAME=FoodHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
FOODHUB_VERSION=1.5.0
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@foodhub.test"
MAIL_FROM_NAME="FoodHub"

# Optional production integrations
GCASH_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
GOOGLE_MAPS_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

FOODHUB_WEBHOOK_SECRET=change-this-in-production

# Production operations
APP_FORCE_HTTPS=false
AUDIT_LOG_RETENTION_DAYS=180

# Phase 2 integrations
GCASH_CHECKOUT_URL=
GCASH_RETURN_URL=http://localhost:8000/payment/gcash/return
GCASH_CANCEL_URL=http://localhost:8000/payment/gcash/cancel
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=PHP
PAYPAL_RETURN_URL=http://localhost:8000/payment/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8000/payment/paypal/cancel
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Phase 5 production
BACKUP_DIR=storage/app/backups
BACKUP_RETENTION_DAYS=14
LOAD_TEST_BASE_URL=http://127.0.0.1:8000
LOAD_TEST_REQUESTS=100
LOAD_TEST_CONCURRENCY=10
MONITOR_HEALTH_URL=/api/v1/health/detailed
